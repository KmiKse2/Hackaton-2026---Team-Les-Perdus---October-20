# Docker Compose reads this file after copying it to .env.
POSTGRES_PASSWORD=lifeflow-local-demo
DEMO_API_TOKEN=
# For local Python, export variables in your shell (or uvicorn --env-file .env).
# DATABASE_URL=postgresql+psycopg://lifeflow:password@localhost:5432/lifeflow
# Backend only; leave empty to disable the optional AI analysis endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
