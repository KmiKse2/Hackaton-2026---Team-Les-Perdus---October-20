# Docker Compose reads this file after copying it to .env.
POSTGRES_PASSWORD=lifeflow-local-demo
DEMO_API_TOKEN=
# For local Python, export variables in your shell (or uvicorn --env-file .env).
# DATABASE_URL=postgresql+psycopg://lifeflow:password@localhost:5432/lifeflow
# Backend only; authentication uses Google Cloud ADC, never API keys.
# Leave GOOGLE_CLOUD_PROJECT empty to disable the optional AI endpoint.
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-02-04c9310f527c
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
